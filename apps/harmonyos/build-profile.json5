{
  "app": {
    // 敏感信息警示：本地签名配置（signingConfigs 的证书路径/口令）请勿提交！
    // 证书与口令由 DevEco Studio 在本机自动生成，存放于用户目录 ~/.ohos/config，
    // 不随仓库分发。需要签名时在 DevEco 中重新执行“自动生成签名”即可。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // 编译 SDK：HarmonyOS 6.0.1（API 21），必须写成「平台版本(API 级别)」。
        // 写成裸版本号（如 "6.0.1"）或编造的版本（如 "26.0.0"）时 hvigor 解析不出 API 级别，
        // 会直接报 00306042「must be string」并中止构建。
        "compileSdkVersion": "6.0.1(21)",
        // 目标 API 版本：与编译 SDK 对齐
        "targetSdkVersion": "6.0.1(21)",
        // 最低兼容 HarmonyOS 6.0（API 20）
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
