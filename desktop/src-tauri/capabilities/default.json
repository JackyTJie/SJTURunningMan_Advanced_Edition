{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的最小能力集：本地对话框与原生主题切换。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color",
    "core:window:allow-show",
    "core:window:allow-close",
    "dialog:allow-open"
  ]
}
